{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ipeds-v2",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:ANTHROPIC_API_KEY = [Environment]::GetEnvironmentVariable('ANTHROPIC_API_KEY','User'); & '.venv\\Scripts\\python.exe' -m streamlit run app.py --server.address 127.0.0.1 --server.port 8517 --server.headless true --browser.gatherUsageStats false"
      ],
      "port": 8517
    },
    {
      "name": "ipeds-v2-serve",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:PORT='8518'; & '.venv\\Scripts\\python.exe' serve.py"
      ],
      "port": 8518
    }
  ]
}